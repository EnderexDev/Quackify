{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the mini player and the tray menu",
  "windows": ["main", "mini", "tray"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-start-dragging",
    "updater:default",
    "log:default"
  ]
}
