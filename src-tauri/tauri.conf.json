{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quackify",
  "version": "0.3.4",
  "identifier": "dev.enderex.quackify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quackify",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0b0b0b",
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDM0Q3MEE0OTE2REFDOUUKUldTZXJHMlJwSEE5ZkpKMVF5b1JuTEhHcnJ4elBLZm9LZlMwamlicFhlUE5jeUdaNndDWjBNRUIK",
      "endpoints": [
        "https://github.com/EnderexDev/Quackify/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
